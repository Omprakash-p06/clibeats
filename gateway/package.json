{
  "name": "clibeats-provider-gateway",
  "version": "1.0.0",
  "description": "Provider-agnostic audio provider gateway service for CliBeats",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:load": "ts-node tests/load/load-test.ts",
    "openapi:generate": "ts-node scripts/generate-openapi.ts",
    "openapi:validate": "ts-node scripts/validate-openapi.ts",
    "ci": "npm run check && npm test && npm run openapi:generate && npm run openapi:validate && npm run test:load"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "yaml": "^2.7.0",
    "youtubei.js": "^17.2.0"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^22.10.10",
    "@vitest/coverage-v8": "^3.2.7",
    "autocannon": "^8.0.0",
    "fast-check": "^3.23.2",
    "ioredis-mock": "^8.9.0",
    "redis-commands": "^1.7.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
