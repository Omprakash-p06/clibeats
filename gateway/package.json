{
  "name": "clibeats-provider-gateway",
  "version": "1.0.0",
  "description": "Provider-agnostic audio provider gateway service for CliBeats",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:load": "ts-node tests/load/load-test.ts",
    "openapi:generate": "ts-node scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.4.0",
    "@fastify/swagger-ui": "^5.2.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/ioredis-mock": "^8.2.8",
    "@types/node": "^22.10.10",
    "autocannon": "^8.0.0",
    "fast-check": "^3.23.2",
    "ioredis-mock": "^5.9.0",
    "redis-commands": "^1.7.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
